<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="32700.99.1234" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="tab-bar">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22685"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Admin Tab Bar Controller-->
        <scene sceneID="tab-scene">
            <objects>
                <tabBarController storyboardIdentifier="AdminTabBarController" id="tab-bar" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="tab-bar-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <color key="tintColor" red="0.23137254901960785" green="0.47843137254901963" blue="0.29411764705882354" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </tabBar>
                    <connections>
                        <segue destination="dashboard-nav" kind="relationship" relationship="viewControllers" id="dashboard-segue"/>
                        <segue destination="donations-nav" kind="relationship" relationship="viewControllers" id="donations-segue"/>
                        <segue destination="impact-nav" kind="relationship" relationship="viewControllers" id="impact-segue"/>
                        <segue destination="table-nav" kind="relationship" relationship="viewControllers" id="table-segue"/>
                        <segue destination="collection-nav" kind="relationship" relationship="viewControllers" id="collection-segue"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tab-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
        
        <!--Dashboard-->
        <scene sceneID="dashboard-nav-scene">
            <objects>
                <navigationController id="dashboard-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Dashboard" image="house.fill" catalog="system" id="dashboard-tab"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="dashboard-navbar">
                        <rect key="frame" x="0.0" y="59" width="393" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="dashboard-vc" kind="relationship" relationship="rootViewController" id="dashboard-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="dashboard-nav-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="900" y="-400"/>
        </scene>
        
        <!--Admin Dashboard View Controller-->
        <scene sceneID="dashboard-scene">
            <objects>
                <viewController id="dashboard-vc" customClass="AdminDashboardViewController" customModule="RePlate" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="dashboard-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="scroll-view">
                                <rect key="frame" x="0.0" y="103" width="393" height="666"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="content-view">
                                        <rect key="frame" x="0.0" y="0.0" width="393" height="800"/>
                                        <subviews>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="header-view">
                                                <rect key="frame" x="0.0" y="0.0" width="393" height="200"/>
                                                <color key="backgroundColor" red="0.23137254901960785" green="0.47843137254901963" blue="0.29411764705882354" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="200" id="header-height"/>
                                                </constraints>
                                            </view>
                                            <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="metrics-stack">
                                                <rect key="frame" x="20" y="220" width="353" height="100"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="100" id="metrics-height"/>
                                                </constraints>
                                            </stackView>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="pending-view">
                                                <rect key="frame" x="20" y="340" width="353" height="150"/>
                                                <color key="backgroundColor" systemColor="systemGray6Color"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="150" id="pending-height"/>
                                                </constraints>
                                            </view>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="activity-view">
                                                <rect key="frame" x="20" y="510" width="353" height="120"/>
                                                <color key="backgroundColor" systemColor="systemGray6Color"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="120" id="activity-height"/>
                                                </constraints>
                                            </view>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="actions-view">
                                                <rect key="frame" x="20" y="650" width="353" height="130"/>
                                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="130" id="actions-height"/>
                                                </constraints>
                                            </view>
                                        </subviews>
                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                        <constraints>
                                            <constraint firstItem="header-view" firstAttribute="leading" secondItem="content-view" secondAttribute="leading" id="header-leading"/>
                                            <constraint firstItem="header-view" firstAttribute="trailing" secondItem="content-view" secondAttribute="trailing" id="header-trailing"/>
                                            <constraint firstItem="header-view" firstAttribute="top" secondItem="content-view" secondAttribute="top" id="header-top"/>
                                            <constraint firstItem="metrics-stack" firstAttribute="top" secondItem="header-view" secondAttribute="bottom" constant="20" id="metrics-top"/>
                                            <constraint firstItem="metrics-stack" firstAttribute="leading" secondItem="content-view" secondAttribute="leading" constant="20" id="metrics-leading"/>
                                            <constraint firstItem="content-view" firstAttribute="trailing" secondItem="metrics-stack" secondAttribute="trailing" constant="20" id="metrics-trailing"/>
                                            <constraint firstItem="pending-view" firstAttribute="top" secondItem="metrics-stack" secondAttribute="bottom" constant="20" id="pending-top"/>
                                            <constraint firstItem="pending-view" firstAttribute="leading" secondItem="content-view" secondAttribute="leading" constant="20" id="pending-leading"/>
                                            <constraint firstItem="content-view" firstAttribute="trailing" secondItem="pending-view" secondAttribute="trailing" constant="20" id="pending-trailing"/>
                                            <constraint firstItem="activity-view" firstAttribute="top" secondItem="pending-view" secondAttribute="bottom" constant="20" id="activity-top"/>
                                            <constraint firstItem="activity-view" firstAttribute="leading" secondItem="content-view" secondAttribute="leading" constant="20" id="activity-leading"/>
                                            <constraint firstItem="content-view" firstAttribute="trailing" secondItem="activity-view" secondAttribute="trailing" constant="20" id="activity-trailing"/>
                                            <constraint firstItem="actions-view" firstAttribute="top" secondItem="activity-view" secondAttribute="bottom" constant="20" id="actions-top"/>
                                            <constraint firstItem="actions-view" firstAttribute="leading" secondItem="content-view" secondAttribute="leading" constant="20" id="actions-leading"/>
                                            <constraint firstItem="content-view" firstAttribute="trailing" secondItem="actions-view" secondAttribute="trailing" constant="20" id="actions-trailing"/>
                                            <constraint firstItem="content-view" firstAttribute="bottom" secondItem="actions-view" secondAttribute="bottom" constant="20" id="content-bottom"/>
                                            <constraint firstAttribute="height" constant="800" id="content-height"/>
                                        </constraints>
                                    </view>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="content-view" firstAttribute="leading" secondItem="scroll-view" secondAttribute="leading" id="content-leading"/>
                                    <constraint firstItem="content-view" firstAttribute="trailing" secondItem="scroll-view" secondAttribute="trailing" id="content-trailing"/>
                                    <constraint firstItem="content-view" firstAttribute="top" secondItem="scroll-view" secondAttribute="top" id="content-top"/>
                                    <constraint firstItem="content-view" firstAttribute="bottom" secondItem="scroll-view" secondAttribute="bottom" id="content-scroll-bottom"/>
                                    <constraint firstItem="content-view" firstAttribute="width" secondItem="scroll-view" secondAttribute="width" id="content-width"/>
                                </constraints>
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="dashboard-safe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="scroll-view" firstAttribute="leading" secondItem="dashboard-safe" secondAttribute="leading" id="scroll-leading"/>
                            <constraint firstItem="dashboard-safe" firstAttribute="trailing" secondItem="scroll-view" secondAttribute="trailing" id="scroll-trailing"/>
                            <constraint firstItem="scroll-view" firstAttribute="top" secondItem="dashboard-safe" secondAttribute="top" id="scroll-top"/>
                            <constraint firstItem="dashboard-safe" firstAttribute="bottom" secondItem="scroll-view" secondAttribute="bottom" id="scroll-bottom"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" id="dashboard-nav-item"/>
                    <connections>
                        <outlet property="headerView" destination="header-view" id="header-outlet"/>
                        <outlet property="metricsStackView" destination="metrics-stack" id="metrics-outlet"/>
                        <outlet property="pendingActionsView" destination="pending-view" id="dashboard-pending-outlet"/>
                        <outlet property="quickActionsView" destination="actions-view" id="actions-outlet"/>
                        <outlet property="recentActivityView" destination="activity-view" id="activity-outlet"/>
                        <segue destination="user-management-vc" kind="show" identifier="showUserManagement" id="user-management-segue"/>
                        <segue destination="ngo-verification-vc" kind="show" identifier="showNGOVerification" id="ngo-verification-segue"/>
                        <segue destination="dispute-resolution-vc" kind="show" identifier="showDisputeResolution" id="dispute-resolution-segue"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="dashboard-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1800" y="-400"/>
        </scene>
        
        <!--Donations-->
        <scene sceneID="donations-nav-scene">
            <objects>
                <navigationController id="donations-nav" sceneMemberID="viewController">
