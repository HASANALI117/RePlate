                                                </constraints>
                                            </stackView>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="chart-view">
                                                <rect key="frame" x="20" y="340" width="353" height="200"/>
                                                <color key="backgroundColor" systemColor="systemGray6Color"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="200" id="chart-height"/>
                                                </constraints>
                                            </view>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="achievements-view">
                                                <rect key="frame" x="20" y="560" width="353" height="120"/>
                                                <color key="backgroundColor" systemColor="systemGray6Color"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="120" id="achievements-height"/>
                                                </constraints>
                                            </view>
                                        </subviews>
                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                        <constraints>
                                            <constraint firstItem="impact-header" firstAttribute="leading" secondItem="impact-content" secondAttribute="leading" id="impact-header-leading"/>
                                            <constraint firstItem="impact-header" firstAttribute="trailing" secondItem="impact-content" secondAttribute="trailing" id="impact-header-trailing"/>
                                            <constraint firstItem="impact-header" firstAttribute="top" secondItem="impact-content" secondAttribute="top" id="impact-header-top"/>
