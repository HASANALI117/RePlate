                                            <constraint firstItem="donations-header" firstAttribute="trailing" secondItem="donations-content" secondAttribute="trailing" id="donations-header-trailing"/>
                                            <constraint firstItem="donations-header" firstAttribute="top" secondItem="donations-content" secondAttribute="top" id="donations-header-top"/>
                                            <constraint firstItem="donations-search" firstAttribute="top" secondItem="donations-header" secondAttribute="bottom" constant="20" id="donations-search-top"/>
                                            <constraint firstItem="donations-search" firstAttribute="leading" secondItem="donations-content" secondAttribute="leading" constant="16" id="donations-search-leading"/>
                                            <constraint firstItem="donations-content" firstAttribute="trailing" secondItem="donations-search" secondAttribute="trailing" constant="16" id="donations-search-trailing"/>
                                            <constraint firstItem="donations-stats" firstAttribute="top" secondItem="donations-search" secondAttribute="bottom" constant="20" id="donations-stats-top"/>
                                            <constraint firstItem="donations-stats" firstAttribute="leading" secondItem="donations-content" secondAttribute="leading" constant="16" id="donations-stats-leading"/>
                                            <constraint firstItem="donations-content" firstAttribute="trailing" secondItem="donations-stats" secondAttribute="trailing" constant="16" id="donations-stats-trailing"/>
