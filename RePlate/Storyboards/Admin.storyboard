        <!--Donation Management View Controller-->
        <scene sceneID="donations-scene">
            <objects>
                <viewController id="donations-vc" customClass="DonationManagementViewController" customModule="RePlate" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="donations-view">
