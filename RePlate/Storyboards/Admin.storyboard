        <!--Your Impact View Controller-->
        <scene sceneID="impact-scene">
            <objects>
                <viewController id="impact-vc" customClass="YourImpactViewController" customModule="RePlate" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="impact-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
