                                                        <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Making a difference, one meal at a time" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="impact-subtitle">
                                                        <rect key="frame" x="20" y="104" width="353" height="24"/>
                                                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                        <color key="textColor" red="1" green="1" blue="1" alpha="0.80000000000000004" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                </subviews>
                                                <color key="backgroundColor" red="0.23137254901960785" green="0.47843137254901963" blue="0.29411764705882354" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="180" id="impact-header-height"/>
                                                    <constraint firstItem="impact-title" firstAttribute="leading" secondItem="impact-header" secondAttribute="leading" constant="20" id="title-leading"/>
                                                    <constraint firstAttribute="trailing" secondItem="impact-title" secondAttribute="trailing" constant="20" id="title-trailing"/>
                                                    <constraint firstItem="impact-title" firstAttribute="top" secondItem="impact-header" secondAttribute="top" constant="60" id="title-top"/>
                                                    <constraint firstItem="impact-subtitle" firstAttribute="leading" secondItem="impact-header" secondAttribute="leading" constant="20" id="subtitle-leading"/>
                                                    <constraint firstAttribute="trailing" secondItem="impact-subtitle" secondAttribute="trailing" constant="20" id="subtitle-trailing"/>
                                                    <constraint firstItem="impact-subtitle" firstAttribute="top" secondItem="impact-title" secondAttribute="bottom" constant="8" id="subtitle-top"/>
                                                </constraints>
                                            </view>
                                            <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="stats-stack">
